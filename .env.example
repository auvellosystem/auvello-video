# Use o banco Neon DO NOVO projeto. Nao envie a .env para o GitHub.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
# Crie uma senha propria com ao menos 16 caracteres para o painel.
ADMIN_PASSWORD=
VIDEO_RECIPIENT=5528999676818
PORT=10000
# No Docker, mantenha python3. No Windows local, pode usar python.
PYTHON_BIN=python3
# Voz neural Piper Faber, instalada dentro de models/.
TTS_ENGINE=piper
TTS_MODEL=models/pt_BR-faber-medium.onnx
# Voz local eSpeak de reserva para evitar perder o vídeo se o Piper falhar.
TTS_FALLBACK=local
